# =============================================================================
# voiceagent-book —— 公开仓库的 .gitignore
#
# 这个仓库是 public 的，它同时承担两个角色：
#   1. 书稿本身（章节、图、大纲）对外公开，作为课程的引流读物
#   2. figures/ 兼作图床：public repo 的 raw.githubusercontent.com 无防盗链，
#      往 CSDN / 公众号 / 知乎 发文时，md 里的图片路径换成 raw URL 即可，
#      平台会自行把图转存到它们自己的 CDN
#
# 所以这里的原则是：**只公开成品，不公开工具链和第三方材料**。
# 改动前先想一遍：这个文件被陌生人看到、被搜索引擎收录，会不会有问题。
# =============================================================================

# --- 第三方材料：绝不能公开 -------------------------------------------------
# template/ 里是出版社的样章模板和提示词文档，属于他人材料，
# 公开传播有版权风险。本地保留，不进 git。
template/

# --- 生成物：可随时重建，不进 git -------------------------------------------
# preview/ 和 final/ 里是 word-generator 产出的 docx，体积大且每次生成都变，
# 进 git 只会把仓库撑大、把 diff 搅乱。
preview/
final/
full_book.md

# publish/ 是 publish-platform 生成的平台发布副本：正文与 chapters/ 完全相同，
# 只把图片路径换成了 CDN 绝对地址。源文件已在仓库里，副本没有入库的必要，
# 而且每换一次 CDN 就全量重写，进 git 只会让 diff 失真。
publish/

# 任何 Word / PDF 都不进仓库。既避免误传出版社模板，
# 也避免把 docx 生成物当成源文件管理。
*.docx
*.pdf

# --- 本地工具链：留在本地 ---------------------------------------------------
# config/  写作规范（book_style / writing_style / content_policy）
# tools/   表格、插图、引用的检查脚本
# 这些是写书过程用的，读者不需要，公开也没有意义。
# 若日后想把写作规范一并开源，删掉下面两行即可。
config/
tools/
agent_paths.py
setup.py
requirements.txt

# --- Python 运行残留 --------------------------------------------------------
__pycache__/
*.py[cod]
venv/
.venv/

# --- 密钥：本仓库不该有，兜底防呆 -------------------------------------------
# 真正的密钥在 ../voiceagent-code/.env，那个目录不属于本仓库。
# 这里列出来纯粹是防止哪天误拷进来。
.env
.env.*
!.env.example

# --- 系统与编辑器 -----------------------------------------------------------
.DS_Store
Thumbs.db
*.swp
.idea/
.vscode/

# =============================================================================
# 明确会被提交的内容（不在忽略列表里，此处仅作备忘）：
#   README.md        仓库门面，作者 / 引流链接 / 章节目录
#   book.yaml        书籍元数据与章节大纲
#   chapters/        各章 Markdown 正文
#   diagrams/        draw.io 源文件，读者可自行打开修改
#   figures/         导出的 PNG，同时充当图床
#   LICENSE
# =============================================================================
