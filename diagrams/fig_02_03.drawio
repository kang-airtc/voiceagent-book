<mxfile host="app.diagrams.net">
  <diagram name="流式与非流式对比">
    <mxGraphModel dx="1000" dy="360" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1000" pageHeight="360" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="title" value="流式与非流式的首字延迟差距" style="text;html=1;align=left;verticalAlign=middle;fontSize=22;fontStyle=1;fontColor=#111111;" vertex="1" parent="1">
          <mxGeometry x="30" y="18" width="600" height="32" as="geometry" />
        </mxCell>
        <mxCell id="sub" value="同一段回答，两种处理方式，用户开始听见声音的时刻相差约 4 倍" style="text;html=1;align=left;verticalAlign=middle;fontSize=15;fontColor=#555555;" vertex="1" parent="1">
          <mxGeometry x="30" y="50" width="760" height="24" as="geometry" />
        </mxCell>

        <mxCell id="l1" value="非流式&#10;整段生成完再播" style="text;html=1;align=left;verticalAlign=middle;fontSize=15;fontColor=#111111;" vertex="1" parent="1">
          <mxGeometry x="30" y="98" width="180" height="48" as="geometry" />
        </mxCell>
        <mxCell id="a1" value="静音+STT" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="220" y="98" width="64" height="48" as="geometry" />
        </mxCell>
        <mxCell id="a2" value="LLM 把整段回答写完　2500 ms" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="284" y="98" width="396" height="48" as="geometry" />
        </mxCell>
        <mxCell id="a3" value="TTS 把整段合完　1200 ms" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="680" y="98" width="190" height="48" as="geometry" />
        </mxCell>
        <mxCell id="a4" value="≈ 4.1 s&#10;才出声" style="text;html=1;align=left;verticalAlign=middle;fontSize=15;fontStyle=1;fontColor=#b85450;" vertex="1" parent="1">
          <mxGeometry x="882" y="98" width="110" height="48" as="geometry" />
        </mxCell>

        <mxCell id="l2" value="流式&#10;边生成边播" style="text;html=1;align=left;verticalAlign=middle;fontSize=15;fontColor=#111111;" vertex="1" parent="1">
          <mxGeometry x="30" y="176" width="180" height="48" as="geometry" />
        </mxCell>
        <mxCell id="c1" value="静音+STT" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="220" y="176" width="64" height="48" as="geometry" />
        </mxCell>
        <mxCell id="c2" value="LLM 首字" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="284" y="176" width="64" height="48" as="geometry" />
        </mxCell>
        <mxCell id="c3" value="TTS" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="348" y="176" width="32" height="48" as="geometry" />
        </mxCell>
        <mxCell id="c4" value="≈ 1.05 s&#10;开始出声" style="text;html=1;align=left;verticalAlign=middle;fontSize=15;fontStyle=1;fontColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="392" y="176" width="120" height="48" as="geometry" />
        </mxCell>
        <mxCell id="c5" value="剩下的边生成边播：用户在听前一句时，后一句已经算好" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#cccccc;dashed=1;fontSize=14;fontColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="520" y="176" width="472" height="48" as="geometry" />
        </mxCell>

        <mxCell id="concl" value="延迟只按首字计算：用户感知到的快慢，就是从他闭嘴到听见第一个字。整段话说完要多久他并不在意，因为耳朵里一直有声音。" style="text;html=1;align=left;verticalAlign=middle;fontSize=14;fontColor=#d79b00;" vertex="1" parent="1">
          <mxGeometry x="30" y="252" width="960" height="24" as="geometry" />
        </mxCell>
        <mxCell id="note" value="横向比例已压缩，仅示意各段的相对长短" style="text;html=1;align=left;verticalAlign=middle;fontSize=13;fontColor=#999999;fontStyle=2;" vertex="1" parent="1">
          <mxGeometry x="30" y="284" width="600" height="22" as="geometry" />
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
