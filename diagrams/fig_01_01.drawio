<mxfile host="Electron" agent="Claude Code" type="device">
  <diagram name="语音对话架构总览" id="voice-agent-overview">
    <mxGraphModel dx="1300" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1300" pageHeight="800" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="front" value="&lt;b style='font-size:18px'&gt;前端&lt;/b&gt;&lt;br&gt;&lt;font color='#1F4E79' style='font-size:13px'&gt;浏览器&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style='font-size:12px'&gt;麦克风采集&lt;br&gt;音频播放&lt;br&gt;对话文字上屏&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#EAF2FD;strokeColor=#6C8EBF;strokeWidth=2.5;fontSize=13;fontColor=#1A1A1A;fontFamily=PingFang SC;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="40" y="220" width="260" height="220" as="geometry" />
        </mxCell>

        <mxCell id="back" value="&lt;b style='font-size:18px'&gt;后端&lt;/b&gt;&lt;br&gt;&lt;font color='#2D6A31' style='font-size:13px'&gt;编排中枢&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style='font-size:12px'&gt;连接与会话管理&lt;br&gt;调度 STT / LLM / TTS&lt;br&gt;VAD 打断控制&lt;br&gt;三层流式转发&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#EAF7EC;strokeColor=#82B366;strokeWidth=2.5;fontSize=13;fontColor=#1A1A1A;fontFamily=PingFang SC;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="560" y="120" width="260" height="420" as="geometry" />
        </mxCell>

        <mxCell id="stt" value="&lt;b style='font-size:16px'&gt;STT&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:12px'&gt;语音 → 文字&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFF4E6;strokeColor=#D79B00;strokeWidth=2.5;fontSize=13;fontColor=#1A1A1A;fontFamily=PingFang SC;" vertex="1" parent="1">
          <mxGeometry x="960" y="140" width="240" height="90" as="geometry" />
        </mxCell>
        <mxCell id="llm" value="&lt;b style='font-size:16px'&gt;LLM&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:12px'&gt;决定说什么&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFF4E6;strokeColor=#D79B00;strokeWidth=2.5;fontSize=13;fontColor=#1A1A1A;fontFamily=PingFang SC;" vertex="1" parent="1">
          <mxGeometry x="960" y="280" width="240" height="90" as="geometry" />
        </mxCell>
        <mxCell id="tts" value="&lt;b style='font-size:16px'&gt;TTS&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:12px'&gt;文字 → 语音&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFF4E6;strokeColor=#D79B00;strokeWidth=2.5;fontSize=13;fontColor=#1A1A1A;fontFamily=PingFang SC;" vertex="1" parent="1">
          <mxGeometry x="960" y="420" width="240" height="90" as="geometry" />
        </mxCell>

        <mxCell id="e-up" value="① 音频上行" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#1F4E79;strokeWidth=3;endArrow=blockThin;endFill=1;fontSize=13;fontStyle=1;fontColor=#1F4E79;fontFamily=PingFang SC;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.227;exitDx=0;exitDy=0;entryX=0;entryY=0.357;entryDx=0;entryDy=0;verticalAlign=bottom;" edge="1" parent="1" source="front" target="back">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e-down" value="⑤ 音频下行" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#1F4E79;strokeWidth=3;endArrow=blockThin;endFill=1;fontSize=13;fontStyle=1;fontColor=#1F4E79;fontFamily=PingFang SC;labelBackgroundColor=#FFFFFF;exitX=0;exitY=0.560;exitDx=0;exitDy=0;entryX=1;entryY=0.614;entryDx=0;entryDy=0;verticalAlign=bottom;" edge="1" parent="1" source="back" target="front">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="lbl-media" value="&lt;b style='font-size:14px'&gt;WebRTC&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px'&gt;音视频传输&lt;/font&gt;" style="text;html=1;align=center;verticalAlign=middle;fontSize=12;fontColor=#1F4E79;fontFamily=PingFang SC;" vertex="1" parent="1">
          <mxGeometry x="300" y="290" width="260" height="42" as="geometry" />
        </mxCell>
        <mxCell id="e-sig" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#7B5EA8;strokeWidth=2;dashed=1;dashPattern=6 4;startArrow=blockThin;startFill=1;endArrow=blockThin;endFill=1;exitX=1;exitY=0.932;exitDx=0;exitDy=0;entryX=0;entryY=0.726;entryDx=0;entryDy=0;" edge="1" parent="1" source="front" target="back">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="lbl-sig" value="&lt;b style='font-size:14px'&gt;WebSocket&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px'&gt;信令 + 控制事件&lt;/font&gt;" style="text;html=1;align=center;verticalAlign=middle;fontSize=12;fontColor=#7B5EA8;fontFamily=PingFang SC;" vertex="1" parent="1">
          <mxGeometry x="300" y="440" width="260" height="42" as="geometry" />
        </mxCell>

        <mxCell id="e-stt-o" value="② 音频" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#D79B00;strokeWidth=2;endArrow=blockThin;endFill=1;fontSize=12;fontColor=#A96800;fontFamily=PingFang SC;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.107;exitDx=0;exitDy=0;entryX=0;entryY=0.167;entryDx=0;entryDy=0;" edge="1" parent="1" source="back" target="stt">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e-stt-b" value="文字" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#D79B00;strokeWidth=2;endArrow=blockThin;endFill=1;fontSize=12;fontColor=#A96800;fontFamily=PingFang SC;labelBackgroundColor=#FFFFFF;exitX=0;exitY=0.833;exitDx=0;exitDy=0;entryX=1;entryY=0.226;entryDx=0;entryDy=0;" edge="1" parent="1" source="stt" target="back">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="e-llm-o" value="③ 文字" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#D79B00;strokeWidth=2;endArrow=blockThin;endFill=1;fontSize=12;fontColor=#A96800;fontFamily=PingFang SC;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.417;exitDx=0;exitDy=0;entryX=0;entryY=0.167;entryDx=0;entryDy=0;" edge="1" parent="1" source="back" target="llm">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e-llm-b" value="回复文字" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#D79B00;strokeWidth=2;endArrow=blockThin;endFill=1;fontSize=12;fontColor=#A96800;fontFamily=PingFang SC;labelBackgroundColor=#FFFFFF;exitX=0;exitY=0.833;exitDx=0;exitDy=0;entryX=1;entryY=0.536;entryDx=0;entryDy=0;" edge="1" parent="1" source="llm" target="back">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="e-tts-o" value="④ 文字" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#D79B00;strokeWidth=2;endArrow=blockThin;endFill=1;fontSize=12;fontColor=#A96800;fontFamily=PingFang SC;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.774;exitDx=0;exitDy=0;entryX=0;entryY=0.167;entryDx=0;entryDy=0;" edge="1" parent="1" source="back" target="tts">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e-tts-b" value="音频" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#D79B00;strokeWidth=2;endArrow=blockThin;endFill=1;fontSize=12;fontColor=#A96800;fontFamily=PingFang SC;labelBackgroundColor=#FFFFFF;exitX=0;exitY=0.833;exitDx=0;exitDy=0;entryX=1;entryY=0.893;entryDx=0;entryDy=0;" edge="1" parent="1" source="tts" target="back">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="note-cycle" value="&lt;b&gt;一轮对话 = ① → ② → ③ → ④ → ⑤&lt;/b&gt;&lt;br&gt;&lt;br&gt;但②③④ 不是排队执行 —— 全程流式，三步彼此重叠：LLM 还在写第二句时，第一句的语音已经在用户耳朵里了。" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFCE8;strokeColor=#D6B656;align=left;verticalAlign=top;spacing=12;fontSize=12;fontColor=#7A5C00;fontFamily=PingFang SC;" vertex="1" parent="1">
          <mxGeometry x="40" y="600" width="560" height="120" as="geometry" />
        </mxCell>
        <mxCell id="note-transport" value="&lt;b&gt;传输层是两条通道，不是二选一&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;WebRTC —— 音视频传输&lt;/b&gt;：走 UDP，抗丢包、能穿 NAT，面向公网的语音产品用它传音频。&lt;br&gt;&lt;b&gt;WebSocket —— 信令 + 控制事件&lt;/b&gt;：先用它交换 SDP 和 ICE 候选把 WebRTC 连接建起来；连上之后继续承载转写文字、状态、打断通知这类消息。&lt;br&gt;&lt;br&gt;&lt;i&gt;本项目做了简化：音频直接走 WebSocket 二进制帧，没引入 WebRTC —— 省掉十几倍代码，代价是丢包和 NAT 穿透没人管。&lt;/i&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFCE8;strokeColor=#D6B656;align=left;verticalAlign=top;spacing=12;fontSize=12;fontColor=#7A5C00;fontFamily=PingFang SC;" vertex="1" parent="1">
          <mxGeometry x="640" y="600" width="560" height="185" as="geometry" />
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
