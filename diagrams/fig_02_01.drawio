        <mxCell id="a3" value="第一块音频" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#2D6A31;strokeWidth=2.5;endArrow=blockThin;endFill=1;fontSize=11;fontColor=#2D6A31;fontFamily=PingFang SC;labelBackgroundColor=#FFFFFF;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1300" y="712" as="sourcePoint" />
            <mxPoint x="1399" y="312" as="targetPoint" />
            <Array as="points">
              <mxPoint x="1300" y="740" />
              <mxPoint x="1399" y="740" />
            </Array>
          </mxGeometry>
        </mxCell>
