        <mxCell id="lbl-g1" value="用户说完&lt;br&gt;（静音开始）" style="text;html=1;align=center;verticalAlign=top;fontSize=11;fontStyle=1;fontColor=#B85450;fontFamily=PingFang SC;" vertex="1" parent="1">
          <mxGeometry x="557" y="805" width="190" height="40" as="geometry" />
        </mxCell>
        <mxCell id="lbl-g2" value="用户听到第一个字" style="text;html=1;align=center;verticalAlign=top;fontSize=11;fontStyle=1;fontColor=#2D6A31;fontFamily=PingFang SC;" vertex="1" parent="1">
          <mxGeometry x="1229" y="805" width="190" height="40" as="geometry" />
        </mxCell>
        <mxCell id="bracket" value="首字延迟 ≈ 1.4 s" style="edgeStyle=none;html=1;strokeColor=#4D4D4D;strokeWidth=2;startArrow=blockThin;startFill=1;endArrow=blockThin;endFill=1;fontSize=13;fontStyle=1;fontColor=#1A1A1A;fontFamily=PingFang SC;labelBackgroundColor=#FFFFFF;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="652" y="785" as="sourcePoint" />
            <mxPoint x="1324" y="785" as="targetPoint" />
          </mxGeometry>
        </mxCell>

        <mxCell id="note1" value="&lt;b&gt;延迟的大头是「等静音」&lt;/b&gt;&lt;br&gt;&lt;br&gt;用户说完到 STT 确认这句结束，中间是 endpointing 在等 —— 图上这段红色的 0.5 s 什么都没在算，纯等。它是首字延迟里最大、也最难省的一块。调小会把句中停顿当成说完（「我想…」就抢答），调大整体变慢。" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFCE8;strokeColor=#D6B656;align=left;verticalAlign=top;spacing=12;fontSize=12;fontColor=#7A5C00;fontFamily=PingFang SC;" vertex="1" parent="1">
          <mxGeometry x="40" y="865" width="710" height="130" as="geometry" />
        </mxCell>
        <mxCell id="note2" value="&lt;b&gt;右半边是重叠的，不是排队的&lt;/b&gt;&lt;br&gt;&lt;br&gt;看 LLM 和 TTS 两条：LLM 还在写后面的内容时，第一句已经在合成；第一句在播放时，第二句已经在合成。所以用户听到的是「说完第一句所需的时间」，不是「整段生成 + 整段合成」的时间。&lt;br&gt;去掉流式，这张图的右半边会拉长两三倍。" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFCE8;strokeColor=#D6B656;align=left;verticalAlign=top;spacing=12;fontSize=12;fontColor=#7A5C00;fontFamily=PingFang SC;" vertex="1" parent="1">
          <mxGeometry x="790" y="865" width="710" height="130" as="geometry" />
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
