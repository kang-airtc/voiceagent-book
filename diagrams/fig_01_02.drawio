        <mxCell id="c-llm" value="LLM 服务&lt;br&gt;&lt;font color='#666666' style='font-size:10px'&gt;任何 OpenAI 兼容端点&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D79B00;strokeWidth=1.5;fontSize=12;fontFamily=PingFang SC;" vertex="1" parent="1">
