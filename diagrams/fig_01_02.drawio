        <mxCell id="g-browser" value="浏览器" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#EAF2FD;strokeColor=#6C8EBF;dashed=1;dashPattern=8 8;verticalAlign=top;align=left;spacingLeft=14;spacingTop=2;fontSize=15;fontStyle=1;fontColor=#1F4E79;fontFamily=PingFang SC;" vertex="1" parent="1">
          <mxGeometry x="40" y="40" width="1220" height="250" as="geometry" />
        </mxCell>
        <mxCell id="g-server" value="服务端　（一个连接 = 一份独立状态）" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#EAF7EC;strokeColor=#82B366;dashed=1;dashPattern=8 8;verticalAlign=top;align=left;spacingLeft=14;spacingTop=2;fontSize=15;fontStyle=1;fontColor=#2D6A31;fontFamily=PingFang SC;" vertex="1" parent="1">
          <mxGeometry x="40" y="330" width="900" height="560" as="geometry" />
        </mxCell>
        <mxCell id="g-cloud" value="云服务　（可替换供应商）" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#FFF4E6;strokeColor=#D79B00;dashed=1;dashPattern=8 8;verticalAlign=top;align=left;spacingLeft=14;spacingTop=2;fontSize=15;fontStyle=1;fontColor=#A96800;fontFamily=PingFang SC;" vertex="1" parent="1">
          <mxGeometry x="970" y="330" width="290" height="560" as="geometry" />
        </mxCell>

        <mxCell id="n1" value="① 麦克风采集&lt;br&gt;&lt;font color='#666666' style='font-size:10px'&gt;echoCancellation 必开&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#6C8EBF;strokeWidth=1.5;fontSize=12;fontFamily=PingFang SC;" vertex="1" parent="1">
          <mxGeometry x="70" y="100" width="170" height="60" as="geometry" />
        </mxCell>
        <mxCell id="n2" value="② 重采样 16 kHz&lt;br&gt;&lt;font color='#666666' style='font-size:10px'&gt;Float32 → Int16 单声道&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#6C8EBF;strokeWidth=1.5;fontSize=12;fontFamily=PingFang SC;" vertex="1" parent="1">
          <mxGeometry x="270" y="100" width="170" height="60" as="geometry" />
        </mxCell>
        <mxCell id="n3" value="③ 分帧 20 ms&lt;br&gt;&lt;font color='#666666' style='font-size:10px'&gt;AudioWorklet 独立线程&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#6C8EBF;strokeWidth=1.5;fontSize=12;fontFamily=PingFang SC;" vertex="1" parent="1">
          <mxGeometry x="470" y="100" width="170" height="60" as="geometry" />
        </mxCell>
        <mxCell id="n12" value="⑫ 无缝播放&lt;br&gt;&lt;font color='#666666' style='font-size:10px'&gt;nextTime 精确排期 · clear 可中断&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#6C8EBF;strokeWidth=1.5;fontSize=12;fontFamily=PingFang SC;" vertex="1" parent="1">
          <mxGeometry x="1000" y="100" width="200" height="60" as="geometry" />
        </mxCell>
        <mxCell id="lbl-down" value="⑪ WebSocket 二进制下行&lt;br&gt;PCM 音频帧 + JSON 事件" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontColor=#1F4E79;fontFamily=PingFang SC;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="690" y="180" width="250" height="45" as="geometry" />
        </mxCell>

        <mxCell id="n5" value="⑤ 分发：每帧走两路" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#82B366;strokeWidth=1.5;fontSize=12;fontFamily=PingFang SC;" vertex="1" parent="1">
          <mxGeometry x="390" y="380" width="200" height="50" as="geometry" />
        </mxCell>
        <mxCell id="n6" value="⑥ STT 客户端&lt;br&gt;&lt;font color='#666666' style='font-size:10px'&gt;interim 中间结果 / final 整句&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#82B366;strokeWidth=1.5;fontSize=12;fontFamily=PingFang SC;" vertex="1" parent="1">
          <mxGeometry x="390" y="470" width="180" height="60" as="geometry" />
        </mxCell>
        <mxCell id="n7" value="⑦ VAD 本地检测&lt;br&gt;&lt;font color='#666666' style='font-size:10px'&gt;RMS 能量 · 自适应噪声底 · 40 ms&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#82B366;strokeWidth=1.5;fontSize=12;fontFamily=PingFang SC;" vertex="1" parent="1">
          <mxGeometry x="100" y="470" width="180" height="60" as="geometry" />
        </mxCell>
        <mxCell id="n8" value="⑧ LLM 客户端&lt;br&gt;&lt;font color='#666666' style='font-size:10px'&gt;stream=true · 带对话历史&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#82B366;strokeWidth=1.5;fontSize=12;fontFamily=PingFang SC;" vertex="1" parent="1">
          <mxGeometry x="390" y="580" width="180" height="60" as="geometry" />
        </mxCell>
        <mxCell id="n9" value="⑨ 切句" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#82B366;strokeWidth=1.5;fontSize=12;fontFamily=PingFang SC;" vertex="1" parent="1">
          <mxGeometry x="390" y="675" width="180" height="45" as="geometry" />
        </mxCell>
        <mxCell id="n10" value="⑩ TTS 客户端（流式）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#82B366;strokeWidth=1.5;fontSize=12;fontFamily=PingFang SC;" vertex="1" parent="1">
          <mxGeometry x="390" y="745" width="180" height="45" as="geometry" />
        </mxCell>
        <mxCell id="n11" value="出站队列（唯一写入者）&lt;br&gt;&lt;font color='#666666' style='font-size:10px'&gt;PCM 二进制帧 + JSON 事件&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#82B366;strokeWidth=1.5;fontSize=12;fontFamily=PingFang SC;" vertex="1" parent="1">
          <mxGeometry x="390" y="825" width="180" height="50" as="geometry" />
        </mxCell>
        <mxCell id="dint" value="打断？&lt;br&gt;&lt;font style='font-size:10px'&gt;VAD 有声 且 正在出声&lt;/font&gt;" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFE6CC;strokeColor=#D79B00;strokeWidth=1.5;fontSize=11;fontFamily=PingFang SC;" vertex="1" parent="1">
          <mxGeometry x="80" y="575" width="220" height="95" as="geometry" />
        </mxCell>

        <mxCell id="note-flow" value="&lt;b&gt;三层流式 —— 缺一层前功尽弃&lt;/b&gt;&lt;br&gt;① LLM 逐 token 吐出&lt;br&gt;② 按句切分，攒够一句立刻送走&lt;br&gt;③ TTS 逐块回传，第一块到就开播&lt;br&gt;&lt;br&gt;任一层退化成「攒齐再传」，前面的努力全白费。" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFCE8;strokeColor=#D6B656;align=left;verticalAlign=top;spacing=10;fontSize=11;fontColor=#7A5C00;fontFamily=PingFang SC;" vertex="1" parent="1">
          <mxGeometry x="40" y="925" width="390" height="125" as="geometry" />
        </mxCell>
        <mxCell id="note-int" value="&lt;b&gt;打断必须做三件事&lt;/b&gt;&lt;br&gt;① cancel 掉 LLM 和 TTS&lt;br&gt;② 清空服务端还没发出的队列&lt;br&gt;③ 通知前端停掉已排期的音频&lt;br&gt;&lt;br&gt;只做①的话，前端缓冲会把话说完。" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFCE8;strokeColor=#D6B656;align=left;verticalAlign=top;spacing=10;fontSize=11;fontColor=#7A5C00;fontFamily=PingFang SC;" vertex="1" parent="1">
          <mxGeometry x="450" y="925" width="390" height="125" as="geometry" />
        </mxCell>
        <mxCell id="note-lat" value="&lt;b&gt;延迟预算&lt;/b&gt;&lt;br&gt;大头是 STT 的 endpointing —— 等多久静音才算一句说完，300–800 ms，且是固有成本。&lt;br&gt;&lt;br&gt;首字响应通常 1–2 s。要压延迟，优先动 endpointing 和切句策略，这两个你能控制。" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFCE8;strokeColor=#D6B656;align=left;verticalAlign=top;spacing=10;fontSize=11;fontColor=#7A5C00;fontFamily=PingFang SC;" vertex="1" parent="1">
          <mxGeometry x="860" y="925" width="400" height="125" as="geometry" />
        </mxCell>

        <mxCell id="c-stt" value="流式 STT 服务&lt;br&gt;&lt;font color='#666666' style='font-size:10px'&gt;Deepgram / 阿里 / 讯飞&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D79B00;strokeWidth=1.5;fontSize=12;fontFamily=PingFang SC;" vertex="1" parent="1">
          <mxGeometry x="1000" y="470" width="230" height="60" as="geometry" />
