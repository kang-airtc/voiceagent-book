          <mxGeometry x="48" y="102" width="944" height="26" as="geometry" />
        </mxCell>
        <mxCell id="b1b" value="你是产品客服。只根据下面的资料回答，资料里没有的就说不知道，不要编。&#10;回答控制在两三句话，用口语说，不要念文档。" style="text;html=1;align=left;verticalAlign=top;fontSize=15;fontColor=#333333;whiteSpace=wrap;" vertex="1" parent="1">
