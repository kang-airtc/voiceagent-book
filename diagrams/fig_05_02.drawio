        <mxCell id="eggT" value="一个副产物" style="text;html=1;align=left;verticalAlign=middle;fontSize=17;fontStyle=1;fontColor=#111111;" vertex="1" parent="1">
          <mxGeometry x="30" y="428" width="400" height="26" as="geometry" />
        </mxCell>
        <mxCell id="eggB" value="连续的空白符号正好对应这段没有人说话。因此不少流式识别服务并不单独运行一套语音活动检测，直接读取声学模型的空白输出即可，判断依据与识别本身天然一致。" style="text;html=1;align=left;verticalAlign=top;fontSize=15;fontColor=#555555;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="30" y="458" width="980" height="48" as="geometry" />
        </mxCell>

