        <mxCell id="blankNote" value="灰色的下画线是空白符号，表示这一帧没有新内容要输出。有了它，模型就不必纠结一个音究竟跨几帧：说得长就多吐几帧同样的字，交给下一步收拾。" style="text;html=1;align=left;verticalAlign=top;fontSize=15;fontColor=#555555;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="30" y="158" width="980" height="44" as="geometry" />
        </mxCell>

        <mxCell id="stepT" value="解码：合并重复，去掉空白" style="text;html=1;align=left;verticalAlign=middle;fontSize=17;fontStyle=1;fontColor=#111111;" vertex="1" parent="1">
          <mxGeometry x="30" y="220" width="400" height="26" as="geometry" />
