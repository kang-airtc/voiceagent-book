<mxfile host="app.diagrams.net">
  <diagram name="两种VAD的判定对比">
    <mxGraphModel dx="1040" dy="500" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1040" pageHeight="500" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="title" value="嘈杂环境下两种 VAD 的判定差异" style="text;html=1;align=left;verticalAlign=middle;fontSize=22;fontStyle=1;fontColor=#111111;" vertex="1" parent="1">
          <mxGeometry x="30" y="18" width="700" height="32" as="geometry" />
        </mxCell>
        <mxCell id="sub" value="以咖啡厅里的三种声音为例：能量 VAD 问的是吵不吵，神经网络 VAD 问的是像不像人在说话" style="text;html=1;align=left;verticalAlign=middle;fontSize=15;fontColor=#555555;" vertex="1" parent="1">
          <mxGeometry x="30" y="50" width="960" height="22" as="geometry" />
        </mxCell>

        <mxCell id="h1" value="声音来源" style="text;html=1;align=left;verticalAlign=middle;fontSize=15;fontStyle=1;fontColor=#111111;" vertex="1" parent="1">
          <mxGeometry x="30" y="96" width="290" height="28" as="geometry" />
        </mxCell>
        <mxCell id="h2" value="能量 VAD 的判定" style="text;html=1;align=center;verticalAlign=middle;fontSize=15;fontStyle=1;fontColor=#111111;" vertex="1" parent="1">
          <mxGeometry x="340" y="96" width="290" height="28" as="geometry" />
        </mxCell>
        <mxCell id="h3" value="神经网络 VAD 的判定" style="text;html=1;align=center;verticalAlign=middle;fontSize=15;fontStyle=1;fontColor=#111111;" vertex="1" parent="1">
          <mxGeometry x="650" y="96" width="290" height="28" as="geometry" />
        </mxCell>
        <mxCell id="hline" value="" style="endArrow=none;html=1;strokeColor=#cccccc;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="30" y="128" as="sourcePoint" />
            <mxPoint x="940" y="128" as="targetPoint" />
          </mxGeometry>
        </mxCell>

        <mxCell id="r1a" value="用户在说话：帮我订个闹钟" style="text;html=1;align=left;verticalAlign=middle;fontSize=15;fontColor=#111111;" vertex="1" parent="1">
          <mxGeometry x="30" y="142" width="290" height="46" as="geometry" />
        </mxCell>
        <mxCell id="r1b" value="判为语音" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=15;" vertex="1" parent="1">
          <mxGeometry x="340" y="142" width="290" height="46" as="geometry" />
        </mxCell>
        <mxCell id="r1c" value="判为语音" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=15;" vertex="1" parent="1">
          <mxGeometry x="650" y="142" width="290" height="46" as="geometry" />
        </mxCell>

        <mxCell id="r2a" value="空调与邻桌音乐：音量比说话还大" style="text;html=1;align=left;verticalAlign=middle;fontSize=15;fontColor=#111111;" vertex="1" parent="1">
          <mxGeometry x="30" y="200" width="290" height="46" as="geometry" />
        </mxCell>
        <mxCell id="r2b" value="判为语音　（误判）" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=15;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="340" y="200" width="290" height="46" as="geometry" />
        </mxCell>
        <mxCell id="r2c" value="判为静音　（正确）" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=15;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="650" y="200" width="290" height="46" as="geometry" />
        </mxCell>

        <mxCell id="r3a" value="真正的安静" style="text;html=1;align=left;verticalAlign=middle;fontSize=15;fontColor=#111111;" vertex="1" parent="1">
          <mxGeometry x="30" y="258" width="290" height="46" as="geometry" />
        </mxCell>
        <mxCell id="r3b" value="判为静音" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;fontSize=15;fontColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="340" y="258" width="290" height="46" as="geometry" />
        </mxCell>
        <mxCell id="r3c" value="判为静音" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;fontSize=15;fontColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="650" y="258" width="290" height="46" as="geometry" />
        </mxCell>

        <mxCell id="sep" value="" style="endArrow=none;html=1;strokeColor=#dddddd;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="30" y="330" as="sourcePoint" />
            <mxPoint x="940" y="330" as="targetPoint" />
          </mxGeometry>
        </mxCell>

        <mxCell id="why1" value="用能量 VAD 做断句会发生什么" style="text;html=1;align=left;verticalAlign=middle;fontSize=16;fontStyle=1;fontColor=#b85450;" vertex="1" parent="1">
          <mxGeometry x="30" y="348" width="500" height="24" as="geometry" />
        </mxCell>
        <mxCell id="why2" value="咖啡厅的背景音让它一直输出语音，静音计数器被反复清零，这句话永远不算说完，用户会一直等不到回答。" style="text;html=1;align=left;verticalAlign=top;fontSize=15;fontColor=#333333;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="30" y="376" width="910" height="26" as="geometry" />
        </mxCell>
        <mxCell id="why3" value="根因：能量 VAD 把整段声音压成一个数字，也就是总音量。人声的能量集中在几条固定频带上，噪声则糊在整个频段，这点结构差异一压就没了，自然分不出来。" style="text;html=1;align=left;verticalAlign=top;fontSize=15;fontColor=#666666;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="30" y="412" width="910" height="52" as="geometry" />
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
