          <mxGeometry x="678" y="222" width="184" height="20" as="geometry" />
        </mxCell>
        <mxCell id="pbc" value="同一个人同时收发。SDP 里写一行 sendrecv 就把上行和下行一起协商了，一条连接够用，不需要再配一个拉流协议" style="text;html=1;align=left;verticalAlign=top;fontSize=14;fontColor=#555555;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="548" y="288" width="440" height="48" as="geometry" />
        </mxCell>

        <mxCell id="note" value="是否需要配 WHEP，取决于收流方与发流方是不是同一个端点，而不是取决于音频是单向还是双向。" style="text;html=1;align=left;verticalAlign=top;fontSize=15;fontColor=#555555;whiteSpace=wrap;" vertex="1" parent="1">
