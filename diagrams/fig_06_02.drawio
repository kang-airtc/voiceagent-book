<mxfile host="app.diagrams.net">
  <diagram name="TTS与ASR的对称关系">
    <mxGraphModel dx="1040" dy="420" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1040" pageHeight="420" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="title" value="合成与识别是同一条路的两个方向" style="text;html=1;align=left;verticalAlign=middle;fontSize=22;fontStyle=1;fontColor=#111111;" vertex="1" parent="1">
          <mxGeometry x="30" y="18" width="800" height="32" as="geometry" />
        </mxCell>
        <mxCell id="sub" value="两头对调，中间不变：识别把波形压成频谱再认出字，合成从字画出频谱再还原成波形" style="text;html=1;align=left;verticalAlign=middle;fontSize=15;fontColor=#555555;" vertex="1" parent="1">
          <mxGeometry x="30" y="50" width="980" height="22" as="geometry" />
        </mxCell>

        <mxCell id="lA" value="语音识别" style="text;html=1;align=left;verticalAlign=middle;fontSize=17;fontStyle=1;fontColor=#111111;" vertex="1" parent="1">
          <mxGeometry x="30" y="106" width="150" height="54" as="geometry" />
        </mxCell>
        <mxCell id="a1" value="波形" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=16;" vertex="1" parent="1">
          <mxGeometry x="200" y="106" width="230" height="54" as="geometry" />
        </mxCell>
        <mxCell id="aA1" value="" style="endArrow=classic;html=1;strokeColor=#6c8ebf;strokeWidth=2;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry"><mxPoint x="432" y="133" as="sourcePoint" /><mxPoint x="486" y="133" as="targetPoint" /></mxGeometry>
        </mxCell>
        <mxCell id="a2" value="梅尔频谱" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=16;" vertex="1" parent="1">
          <mxGeometry x="488" y="106" width="230" height="54" as="geometry" />
        </mxCell>
        <mxCell id="aA2" value="" style="endArrow=classic;html=1;strokeColor=#6c8ebf;strokeWidth=2;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry"><mxPoint x="720" y="133" as="sourcePoint" /><mxPoint x="774" y="133" as="targetPoint" /></mxGeometry>
        </mxCell>
        <mxCell id="a3" value="文字" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=16;" vertex="1" parent="1">
          <mxGeometry x="776" y="106" width="234" height="54" as="geometry" />
        </mxCell>

        <mxCell id="lT" value="语音合成" style="text;html=1;align=left;verticalAlign=middle;fontSize=17;fontStyle=1;fontColor=#111111;" vertex="1" parent="1">
          <mxGeometry x="30" y="196" width="150" height="54" as="geometry" />
        </mxCell>
        <mxCell id="t1" value="文字" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=16;" vertex="1" parent="1">
          <mxGeometry x="200" y="196" width="230" height="54" as="geometry" />
        </mxCell>
        <mxCell id="tA1" value="" style="endArrow=classic;html=1;strokeColor=#82b366;strokeWidth=2;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry"><mxPoint x="432" y="223" as="sourcePoint" /><mxPoint x="486" y="223" as="targetPoint" /></mxGeometry>
        </mxCell>
        <mxCell id="t2" value="梅尔频谱" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=16;" vertex="1" parent="1">
          <mxGeometry x="488" y="196" width="230" height="54" as="geometry" />
