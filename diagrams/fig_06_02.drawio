        </mxCell>

        <mxCell id="note" value="梅尔频谱是两套系统共用的中间表示。它描述的是声音在各个频率上的能量分布，既能从波形算出来，也能反过来还原成波形。理解了其中一个方向，另一个方向反着读一遍即可。" style="text;html=1;align=left;verticalAlign=top;fontSize=15;fontColor=#555555;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="30" y="310" width="980" height="52" as="geometry" />
        </mxCell>

