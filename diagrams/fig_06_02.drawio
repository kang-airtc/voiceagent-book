        <mxCell id="t3" value="波形" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=16;" vertex="1" parent="1">
          <mxGeometry x="776" y="196" width="234" height="54" as="geometry" />
        </mxCell>

        <mxCell id="mid" value="两条路都经过梅尔频谱这一站" style="text;html=1;align=center;verticalAlign=middle;fontSize=15;fontStyle=2;fontColor=#d79b00;" vertex="1" parent="1">
          <mxGeometry x="488" y="262" width="230" height="24" as="geometry" />
        </mxCell>
        <mxCell id="midline" value="" style="endArrow=none;html=1;strokeColor=#d79b00;dashed=1;" edge="1" parent="1">
